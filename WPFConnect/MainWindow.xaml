<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="WPFConnect.MainWindow"
        Title="P2P Chat" 
        Height="600" 
        Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="LeftPanel" BorderBrush="Black" BorderThickness="1"  Background="#FF16213E">
            <StackPanel>
                <Border BorderBrush="Black" BorderThickness="1" Height="100" Background="#FF0F172A" Padding="20,20,20,20">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="P2P Chat" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="PeerCountText" TextWrapping="Wrap" Text="0 peers online" Foreground="#888888"/>
                    </StackPanel>
                </Border>
                <ListView >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Text="{Binding}" Foreground="White" Padding="15,10"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    

                </ListView>


            </StackPanel>


        </Border>
        <Border x:Name="RightPanel" BorderBrush="Black" BorderThickness="1" Grid.Column="1" Background="#FF1A1A2E" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="1" Padding="20">
                    <TextBlock Name ="MessagesArea" TextWrapping="Wrap" Text="No messages yet" Foreground="#888888"/>
                </ScrollViewer>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Background="#16213E" Padding="20">
                    <TextBlock Name ="ChatWithText" TextWrapping="Wrap" Text="Select a peer to chat with" Foreground="White" FontSize="16"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Row="2" Background="#16213E" Padding="20">
                    <TextBlock Name ="MessageTextBox" TextWrapping="Wrap" Text="Type a message to send here" Grid.Column="0" Background="#2D2D3A" Foreground="White" Padding="10"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>